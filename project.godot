; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="idvault"
config/version="0.01"
run/main_scene="uid://d3mw360ur5mac"
config/features=PackedStringArray("4.6", "Mobile")
run/low_processor_mode=true
config/icon="res://icon.svg"

[autoload]

KeyboardModifiers="*uid://d1p6olc3jg60n"

[display]

window/vsync/vsync_mode=0

[internationalization]

locale/translations=PackedStringArray("res://res/lang/po/en.po", "res://res/lang/po/en.mo")
locale/translations_pot_files=PackedStringArray("res://scn/Panels/ItemListPanel.tscn", "res://scn/Dialogs/MessageBox.tscn", "res://scn/Dialogs/NewItem.tscn", "res://scn/Dialogs/TestReturn.tscn", "res://res/menus/panel/itemlist/ItemMenu.gd")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
